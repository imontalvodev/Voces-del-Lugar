# cp deploy/.env.example .env  y rellenar. No se commitea.
POSTGRES_PASSWORD=
# Al menos 32 caracteres: openssl rand -hex 32
JWT_SECRET=

# Detrás del proxy del homelab (el que pone el HTTPS): deja :80 y cambia el
# puerto publicado. Sin HTTPS el navegador no da micrófono ni posición.
SITE_ADDRESS=:80
HTTP_PORT=8080
HTTPS_PORT=8443
# Origen público con el que se entra, p. ej. https://voces.casa.lan
CORS_ORIGINS=https://voces.example

# Con Caddy directo a internet: SITE_ADDRESS=voces.example, HTTP_PORT=80, HTTPS_PORT=443
