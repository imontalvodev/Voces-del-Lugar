<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12 o posterior: la pantalla de arranque del sistema, con el
         fondo cal y el icono centrado, sin animación. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/cal</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground_inset</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/icono_fondo</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/cal</item>
    </style>
</resources>
