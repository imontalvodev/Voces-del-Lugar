# SITE_ADDRESS=:80 sirve HTTP plano, para ir detrás de otro proxy que ya pone
# el HTTPS. Con un dominio (voces.example) Caddy pide su propio certificado.
# SITE_ADDRESS=https:// con TLS_MODE=internal sirve HTTPS en cualquier nombre o
# IP con un certificado propio de Caddy, sin dominio (el navegador avisa una vez).
{$SITE_ADDRESS::80} {
	import /etc/caddy/tls-{$TLS_MODE:none}.conf
	encode zstd gzip
	handle /api/* {
		reverse_proxy api:8000
	}
	handle {
		root * /srv
		# Lo que cambia en cada despliegue se revalida (ETag, barato si no cambió);
		# el resto se guarda una hora, así el wasm de 3 MB no se pide en cada visita.
		# (incluidas las direcciones como /historia/<id>, que sirven el index).
		@estatico path /canvaskit/* /assets/* /icons/* /favicon.png
		header @estatico Cache-Control "public, max-age=3600"
		@revalidar not path /canvaskit/* /assets/* /icons/* /favicon.png
		header @revalidar Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
